; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Wawa"
config/description="Game edukatif untuk anak 1-5 tahun: angka, warna, hewan, musik, mewarnai, puzzle."
run/main_scene="res://scenes/Splash.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://assets/app_icon.png"

; boot_splash = gambar yang Godot sendiri tampilkan SANGAT singkat saat
; engine baru boot, SEBELUM scenes/Splash.tscn (maskot "Wawa") jalan —
; beda lapisan, bukan duplikat. Landscape karena app ini landscape-only
; (lihat [display] di bawah). Lihat docs/ASSET_LIST.md #7.
boot_splash/image="res://assets/splash_landscape.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

[display]

; Update 2026-11-20: user minta LANDSCAPE (bukan portrait) — supaya lebar,
; lebih menyesuaikan HP (rotasi landscape) dan tablet. Base resolusi desain
; 1280x720 (16:9), semua ukuran piksel di kode (custom_minimum_size dkk)
; dihitung relatif ke ini, lalu Godot scale otomatis ke resolusi device
; asli lewat stretch mode di bawah — supaya 1 kode UI konsisten
; proporsinya di HP kecil maupun tablet besar, bukan "kececeran"/beda-beda
; posisi tiap device. Lihat obsidian-vault/Decisions Log.md.
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0

; window_width/height_override cuma ngaruh ke UKURAN JENDELA desktop (dev
; test di Windows/Mac/Linux) — TIDAK ngaruh ke export Android (device asli
; selalu pakai resolusi device sendiri). 960x540 tetap rasio 16:9, muat
; nyaman di layar manapun (termasuk laptop 1366x768 yang dipakai testing).
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[gui]

; Font "Baloo 2" (Google Fonts, SIL Open Font License — lihat
; core/assets/fonts/Baloo2-OFL.txt) dipasang jadi font default SELURUH
; app lewat 1 baris ini — bukan di-set manual per Label/Button. Ini
; yang sudah direncanakan dari awal di docs/UI_UX_DESIGN.md ("Tipografi:
; Baloo 2") tapi file-nya baru benar-benar diunduh & dipasang 2026-11-22
; (sebelumnya cuma rencana, semua teks masih pakai font default Godot
; yang terasa polos/tidak sesuai gaya game anak — dilaporkan user).
theme/custom_font="res://core/assets/fonts/Baloo2.ttf"

; Update 2026-11-22: user minta semua teks/tombol dibesarkan — balita
; tidak seharusnya lihat teks kecil (ini app anak, bukan app dewasa).
; `default_font_size` ini jadi baseline buat SEMUA Label/Button yang
; TIDAK punya `add_theme_font_size_override` eksplisit di kode (sebelumnya
; diam-diam pakai ukuran default Godot ~16px, kekecilan). Font size yang
; sudah eksplisit di kode (judul 28→34 dkk) dibesarkan terpisah per file,
; lihat obsidian-vault/Decisions Log.md.
theme/default_font_size=22

[autoload]

ProgressRepository="*res://core/scripts/progress_repository.gd"
SfxService="*res://core/scripts/sfx_service.gd"
AudioService="*res://core/scripts/audio_service.gd"
GameFlow="*res://core/scripts/game_flow.gd"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
