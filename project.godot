; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Bayi GuguGaga"
config/description="Game edukatif untuk anak 1-5 tahun: angka, warna, hewan, musik, mewarnai, puzzle."
run/main_scene="res://scenes/Splash.tscn"
config/features=PackedStringArray("4.7")

[display]

; Base resolution desain = HP portrait biasa. Semua ukuran piksel di kode
; (custom_minimum_size dkk) dihitung relatif ke ini, lalu Godot scale
; otomatis ke resolusi device asli lewat stretch mode di bawah — supaya
; 1 kode UI konsisten proporsinya di HP kecil maupun tablet besar, bukan
; "kececeran"/beda-beda posisi tiap device. Lihat obsidian-vault/Decisions Log.md.
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="portrait"

[autoload]

ProgressRepository="*res://core/scripts/progress_repository.gd"
SfxService="*res://core/scripts/sfx_service.gd"
AudioService="*res://core/scripts/audio_service.gd"
GameFlow="*res://core/scripts/game_flow.gd"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
