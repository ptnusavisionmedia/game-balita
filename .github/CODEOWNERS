# Isi dengan GitHub username tiap pemegang modul (lihat docs/TEAM.md, docs/ROLES.md)
# Siapa pun yang membuka PR yang menyentuh path ini akan otomatis minta review ke owner-nya.

packages/core/                       @bramantyo
packages/app/                        @dev-app

packages/feature_angka/              @dev-angka
packages/feature_warna/              @dev-warna
packages/feature_hewan/              @dev-hewan
packages/feature_musik/              @dev-musik
packages/feature_mewarnai/           @dev-mewarnai
packages/feature_puzzle/             @dev-puzzle

# Dev Testing lintas-modul, otomatis ke-notify di folder test semua modul.
packages/*/test/                     @dev-testing

# Infra tetap di Bramantyo untuk sekarang (lihat docs/TEAM.md "role lintas-modul").
Dockerfile                           @bramantyo
docker-compose.yml                   @bramantyo
melos.yaml                           @bramantyo
.github/workflows/                   @bramantyo

# Asset/design generalist (Asset 1-6), tidak dibatasi 1 jenis media.
packages/*/assets/images/            @asset-1 @asset-4
packages/*/assets/audio/             @asset-2 @asset-5
marketing/                           @asset-3 @asset-6
